<view class="app">
    <!-- 首页内容放进 scroll-view：滚动条用原生属性隐藏；弹层打开时关掉 scroll-y，滚动不会穿透到首页 -->
    <scroll-view class="page-scroll"
                 scroll-y="{{!showTaskSheet && !showSettingsSheet && !showPointsSheet}}"
                 enhanced="{{true}}" show-scrollbar="{{false}}" bounces="{{false}}">
    <view class="header">
        <view class="header-left">
            <text class="header-date">{{todayText}}</text>
            <text class="header-greeting" style="color:{{pointLevelColor}}">「{{encourageText}}」</text>
        </view>
        <view class="header-badge" style="background:{{avatarBg}}">
            <text>{{avatarEmoji}}</text>
        </view>
    </view>

    <view class="error-strip" wx:if="{{errorMsg}}">
        <text class="error-text">{{errorMsg}}</text>
        <text class="error-retry" bindtap="handleRetry">重试</text>
    </view>

    <!-- 首次进入（无本机快照）时的同构骨架屏，页面结构立刻可见，不留白屏。 -->
    <block wx:if="{{loading}}">
        <view class="skeleton">
            <view class="sk sk-heading"></view>
            <view class="sk-strip">
                <view class="sk sk-chip"></view>
                <view class="sk sk-chip"></view>
                <view class="sk sk-chip short"></view>
            </view>
            <view class="sk-checkin">
                <view class="sk-checkin-top">
                    <view class="sk sk-avatar"></view>
                    <view class="sk-checkin-lines">
                        <view class="sk sk-line w60"></view>
                        <view class="sk sk-line w40"></view>
                    </view>
                </view>
                <view class="sk sk-action"></view>
            </view>
            <view class="card sk-point-card">
                <view class="sk sk-line w40"></view>
                <view class="sk sk-point-box"></view>
                <view class="sk sk-line w80"></view>
            </view>
            <view class="card sk-calendar">
                <view class="sk sk-line w40"></view>
                <view class="sk-week">
                    <view wx:for="{{skeletonDays}}" wx:key="*this" class="sk sk-day"></view>
                </view>
                <view class="sk-legend">
                    <view class="sk sk-line w30"></view>
                    <view class="sk sk-line w30"></view>
                    <view class="sk sk-line w30"></view>
                </view>
            </view>
            <view class="card sk-records">
                <view class="sk sk-line w50"></view>
                <view class="sk sk-line w80"></view>
                <view class="sk sk-line w70"></view>
            </view>
        </view>
    </block>

    <!-- 初始化失败时的兜底卡片，正常进入不会出现；界面不暴露登录细节。 -->
    <block wx:elif="{{authState !== 'signed-in'}}">
        <view class="login-card">
            <text class="login-emoji">🔄</text>
            <text class="login-title">{{authView.title}}</text>
            <text class="login-desc">{{authView.desc}}</text>
            <button class="primary-btn" bindtap="handleRetry">{{authView.button}}</button>
            <text class="login-note">首次使用会自动创建默认昵称和头像，可在「我的 - 设置」里修改。</text>
        </view>
    </block>

    <block wx:else>
        <block wx:if="{{tab === 'checkin'}}">
            <view class="section-head">
                <text class="section-title">我的签到任务<text class="section-count">{{tasks.length}}/{{maxTasks}}</text></text>
                <text class="section-link" bindtap="openTaskSheet">{{tasks.length >= maxTasks ? '已达上限' : '＋ 新建'}}</text>
            </view>

            <view class="task-strip" wx:if="{{tasks.length > 0}}">
                <view wx:for="{{tasks}}" wx:key="id" class="task-chip {{item.id === activeTaskId ? 'active' : ''}}"
                      style="border-color:{{item.id === activeTaskId ? item.color : '#E9ECF2'}}"
                      data-id="{{item.id}}" data-title="{{item.title}}"
                      hover-class="task-chip-hover" hover-stay-time="80"
                      bindtap="selectTask" bindlongpress="onTaskLongPress">
                    <text class="task-chip-icon">{{item.icon}}</text>
                    <text class="task-chip-name">{{item.title}}</text>
                </view>
                <view class="task-chip add" bindtap="openTaskSheet">
                    <text class="task-chip-icon">＋</text>
                    <text class="task-chip-name">新建</text>
                </view>
            </view>
            <text class="task-tip" wx:if="{{tasks.length > 0}}">长按任务标签可修改或删除</text>

            <view wx:if="{{tasks.length === 0}}" class="empty-card">
                <text class="empty-emoji">📝</text>
                <text class="empty-title">还没有签到任务</text>
                <text class="empty-desc">新建一个任务，比如「早起」「阅读」「运动」</text>
                <button class="primary-btn small" bindtap="openTaskSheet">新建签到任务</button>
            </view>

            <view wx:if="{{activeTask}}" class="checkin-card" style="background:{{activeTask.color}}">
                <view class="checkin-top">
                    <text class="checkin-icon">{{activeTask.icon}}</text>
                    <view class="checkin-meta">
                        <text class="checkin-name">{{activeTask.title}}</text>
                        <text class="checkin-sub">本任务连续 {{stats.streak}} 天</text>
                    </view>
                    <text class="edit-task-btn" data-id="{{activeTask.id}}" bindtap="onEditTask">编辑</text>
                </view>
                <button class="checkin-btn {{todaySigned ? 'done' : ''}}" bindtap="onCheckIn"
                        disabled="{{todaySigned || checking || syncing}}"
                        loading="{{checking || (syncing && !todaySigned)}}">{{todaySigned ? '今日已签到 ✓' : '今日签到'}}</button>
                <text class="checkin-hint">{{todaySigned ? '明天再来，坚持就是胜利' : '每天只能签到一次，别忘记啦'}}</text>
            </view>

            <!-- 积分按用户 + 自然日累计：每天只有首次签到计分，与当前选中任务无关。 -->
            <view class="card point-card" bindtap="openPointsSheet">
                <view class="point-head">
                    <view class="point-head-left">
                        <text class="point-title">我的签到积分</text>
                        <view class="point-total-row">
                            <text class="point-total" style="color:{{pointLevelColor}}">{{points.total}}</text>
                            <text class="point-unit">分</text>
                        </view>
                    </view>
                    <text class="point-level" style="color:{{pointLevelColor}};background:{{pointLevelTint}}">{{pointLevel}}</text>
                </view>
                <view class="point-meta">
                    <text wx:if="{{points.today > 0}}">今日 +{{points.today}} 分 · 连续打卡 {{points.streak}} 天</text>
                    <text wx:else>今日首次签到 +{{points.per_checkin}} 分 · 连续打卡 {{points.streak}} 天</text>
                </view>
            </view>

            <view class="card calendar-card">
                <view class="calendar-head">
                    <text class="cal-nav" data-delta="-1" bindtap="switchMonth">‹</text>
                    <text class="cal-title">{{calendarTitle}}</text>
                    <text class="cal-nav" data-delta="1" bindtap="switchMonth">›</text>
                </view>
                <view class="calendar-summary">
                    <text>当月已签到 {{stats.monthCount}} 次</text>
                </view>
                <view class="week-row">
                    <view wx:for="{{weekdays}}" wx:key="*this" class="week-cell"><text>{{item}}</text></view>
                </view>
                <view class="cal-grid">
                    <block wx:for="{{calendarCells}}" wx:key="key">
                        <view wx:if="{{item.blank}}" class="cal-cell blank"></view>
                        <view wx:else class="cal-cell {{item.signed ? 'is-signed' : 'is-plain'}} {{item.isToday ? 'is-today' : ''}} {{item.isFuture ? 'is-future' : ''}}">
                            <text class="cal-day">{{item.day}}</text>
                            <text wx:if="{{item.signed}}" class="cal-check">✓</text>
                        </view>
                    </block>
                </view>
                <view class="legend">
                    <view class="legend-item"><view class="legend-dot signed"></view><text>已签到</text></view>
                    <view class="legend-item"><view class="legend-dot plain"></view><text>未签到</text></view>
                    <view class="legend-item"><view class="legend-dot today"></view><text>今天</text></view>
                </view>
            </view>

            <view class="card record-card">
                <text class="card-title">当月签到记录</text>
                <view wx:if="{{recentRecords.length === 0}}" class="record-empty">当月还没有签到记录</view>
                <view wx:for="{{recentRecords}}" wx:key="id" class="record-row">
                    <view class="record-dot"></view>
                    <text class="record-date">{{item.date}}</text>
                    <text class="record-time">{{item.time}}</text>
                    <text wx:if="{{item.earned_points > 0}}" class="record-tag earned">+{{item.earned_points}} 分</text>
                    <text wx:else class="record-tag">已签到</text>
                </view>
            </view>
        </block>

        <block wx:else>
            <view class="card profile-card">
                <view class="profile-head">
                    <view class="avatar" style="background:{{avatarBg}}"><text>{{avatarEmoji}}</text></view>
                    <view class="profile-info">
                        <text class="profile-name">{{user.nickname}}</text>
                        <text class="profile-sub">加入于 {{joinDate}}</text>
                    </view>
                    <text class="edit-link" bindtap="openSettings">设置</text>
                </view>
                <view class="info-row">
                    <text class="info-label">微信 OpenID</text>
                    <text class="info-value">{{openidText}}</text>
                </view>
            </view>

            <view class="card">
                <text class="card-title">数据概览</text>
                <view class="point-brief" bindtap="openPointsSheet">
                    <view>
                        <text class="point-brief-label">签到积分</text>
                        <text class="point-brief-num" style="color:{{pointLevelColor}}">{{points.total}}</text>
                    </view>
                    <text class="point-brief-level" style="color:{{pointLevelColor}}">{{pointLevel}} ›</text>
                </view>
                <view class="stats-row inner">
                    <view class="stat-item">
                        <text class="stat-num">{{tasks.length}}</text>
                        <text class="stat-label">签到任务</text>
                    </view>
                    <view class="stat-divider"></view>
                    <view class="stat-item">
                        <text class="stat-num">{{stats.totalCount}}</text>
                        <text class="stat-label">累计签到</text>
                    </view>
                    <view class="stat-divider"></view>
                    <view class="stat-item">
                        <text class="stat-num">{{stats.streak}}</text>
                        <text class="stat-label">连续天数</text>
                    </view>
                </view>
            </view>

        </block>
    </block>
    </scroll-view>

    <view wx:if="{{showTaskSheet}}" class="mask" bindtap="closeTaskSheet" catchtouchmove="noop">
        <view class="sheet" catchtap="noop">
            <text class="sheet-title">{{taskEditId ? '修改签到任务' : '新建签到任务'}}</text>
            <text class="sheet-label">任务名称</text>
            <input class="field" value="{{taskDraft.title}}" bindinput="onTaskTitleInput" placeholder="例如：每天阅读 30 分钟" maxlength="{{maxTaskTitleLength}}" />
            <view class="field-meta">
                <text class="field-count {{taskTitleCount >= maxTaskTitleLength ? 'limit' : ''}}">{{taskTitleCount}}/{{maxTaskTitleLength}}</text>
            </view>
            <text class="sheet-label">选个图标</text>
            <view class="icon-grid">
                <view wx:for="{{taskIcons}}" wx:key="*this" class="icon-option {{item === taskDraft.icon ? 'active' : ''}}"
                      data-value="{{item}}" bindtap="selectIcon"><text>{{item}}</text></view>
            </view>
            <text class="sheet-label">主题颜色</text>
            <view class="color-grid">
                <view wx:for="{{taskColors}}" wx:key="*this" class="color-option {{item === taskDraft.color ? 'active' : ''}}"
                      style="background:{{item}}" data-value="{{item}}" bindtap="selectColor"></view>
            </view>
            <view class="sheet-actions">
                <button class="ghost-btn" bindtap="closeTaskSheet">取消</button>
                <button class="primary-btn" bindtap="submitTask" loading="{{taskBusy}}" disabled="{{taskBusy}}">{{taskEditId ? '保存修改' : '创建任务'}}</button>
            </view>
        </view>
    </view>

    <view wx:if="{{showSettingsSheet}}" class="mask" bindtap="closeSettings" catchtouchmove="noop">
        <view class="sheet" catchtap="noop">
            <text class="sheet-title">账号设置</text>
            <view class="settings-preview" style="background:{{settingsAvatarBg}}">
                <text class="settings-preview-emoji">{{settingsAvatarEmoji}}</text>
                <text class="settings-preview-name">{{settingsDraft.nickname || '我的昵称'}}</text>
            </view>
            <text class="sheet-label">昵称</text>
            <input class="field" value="{{settingsDraft.nickname}}" bindinput="onSettingsNicknameInput" placeholder="输入昵称" maxlength="{{maxNicknameLength}}" />
            <view class="field-meta">
                <text class="field-count {{nicknameCount >= maxNicknameLength ? 'limit' : ''}}">{{nicknameCount}}/{{maxNicknameLength}}</text>
            </view>
            <text class="sheet-label">头像</text>
            <view class="avatar-grid">
                <view wx:for="{{avatarPresets}}" wx:key="key" class="avatar-option {{item.key === settingsDraft.avatar ? 'active' : ''}}"
                      style="background:{{item.bg}}" data-key="{{item.key}}" bindtap="selectSettingsAvatar">
                    <text>{{item.emoji}}</text>
                </view>
            </view>
            <view class="sheet-actions">
                <button class="ghost-btn" bindtap="closeSettings">取消</button>
                <button class="primary-btn" bindtap="saveSettings" loading="{{settingsBusy}}" disabled="{{settingsBusy}}">保存</button>
            </view>
        </view>
    </view>

    <!-- 积分与等级：所有门槛、当前进度和档位规则集中在这里 -->
    <view wx:if="{{showPointsSheet}}" class="mask" bindtap="closePointsSheet" catchtouchmove="noop">
        <scroll-view class="sheet points-sheet" scroll-y="true" enhanced="{{true}}" show-scrollbar="{{false}}" bounces="{{false}}" catchtap="noop">
            <text class="sheet-title">积分与等级</text>
            <view class="points-summary">
                <view>
                    <text class="points-summary-label">当前积分</text>
                    <text class="points-summary-value" style="color:{{pointLevelColor}}">{{points.total}}</text>
                </view>
                <view class="points-summary-side">
                    <text class="points-summary-level" style="color:{{pointLevelColor}};background:{{pointLevelTint}}">{{pointLevel}}</text>
                    <text class="points-summary-sub">今日 +{{points.today}} · 连续打卡 {{points.streak}} 天</text>
                </view>
            </view>

            <text class="sheet-label">等级一览</text>
            <view wx:for="{{pointLevels}}" wx:key="name" class="level-row {{item.current ? 'current' : ''}}">
                <view class="level-dot" style="background:{{item.dotColor}}"></view>
                <text class="level-badge" style="color:{{item.color}};background:{{item.tint}}">{{item.badge}}</text>
                <text class="level-name {{item.current ? 'current' : ''}}" style="color:{{item.color}}">{{item.name}}</text>
                <text class="level-range">{{item.range}}</text>
                <text wx:if="{{item.current}}" class="level-state current" style="color:{{item.color}}">当前</text>
                <text wx:elif="{{item.reached}}" class="level-state">已达成</text>
                <text wx:else class="level-state pending">还差 {{item.gap}} 分</text>
            </view>

            <text class="sheet-label">积分规则</text>
            <view class="rule-note">
                <text>每天只有首次签到计分，同一天签多个任务不重复加分。</text>
                <text>连续签到按阶段递增，断签后回到初始积分。</text>
                <text wx:if="{{points.next_stage_days > 0}}">当前连续 {{points.streak}} 天，再连续 {{points.next_stage_days}} 天升一档，单次上限 {{points.max}} 分。</text>
                <text wx:else>已达最高档，每次签到 {{points.max}} 分封顶。</text>
            </view>
            <view wx:for="{{pointStages}}" wx:key="label" class="stage-row">
                <text class="stage-days">{{item.label}}</text>
                <text class="stage-gain">+{{item.gain}} 分</text>
                <text wx:if="{{item.capped}}" class="stage-cap">封顶</text>
            </view>

            <view class="sheet-actions">
                <button class="primary-btn" bindtap="closePointsSheet">知道了</button>
            </view>
        </scroll-view>
    </view>

    <view class="tabbar">
        <view class="tab-item {{tab === 'checkin' ? 'active' : ''}}" data-tab="checkin" bindtap="switchTab">
            <text class="tab-icon">✓</text>
            <text class="tab-text">签到</text>
        </view>
        <view class="tab-item {{tab === 'profile' ? 'active' : ''}}" data-tab="profile" bindtap="switchTab">
            <view class="tab-icon profile-icon">
                <view class="profile-icon-head"></view>
                <view class="profile-icon-body"></view>
            </view>
            <text class="tab-text">我的</text>
        </view>
    </view>
</view>
