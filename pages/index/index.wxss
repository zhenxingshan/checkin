.app {
    box-sizing: border-box;
    height: 100vh;
}

/* 首页滚动交给 scroll-view：页面本身固定高度不再滚动，滚动条由原生属性隐藏 */
.page-scroll {
    box-sizing: border-box;
    height: 100vh;
    padding: 36rpx 28rpx 160rpx;
}

.header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32rpx;
}

.header-left {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.header-date {
    color: #8A93A3;
    font-size: 24rpx;
}

/* 顶部主文案换成当天鼓励语：句子较长，字号收小、最多两行，等级色由行内样式覆盖 */
.header-greeting {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 8rpx;
    color: #1F2329;
    font-size: 30rpx;
    font-weight: 500;
    line-height: 44rpx;
}

.header-badge {
    display: flex;
    flex-shrink: 0;
    width: 88rpx;
    height: 88rpx;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 42rpx;
}

.error-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24rpx;
    padding: 20rpx 24rpx;
    border-radius: 16rpx;
    background: #FFF1EE;
    color: #C4442F;
    font-size: 26rpx;
}

.error-retry {
    font-weight: 600;
    text-decoration: underline;
}

.login-card,
.card,
.empty-card {
    box-sizing: border-box;
    padding: 36rpx 32rpx;
    border-radius: 28rpx;
    background: #FFFFFF;
    box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.04);
}

.login-card,
.empty-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

.login-emoji,
.empty-emoji {
    font-size: 72rpx;
}

.login-title,
.empty-title {
    margin-top: 20rpx;
    font-size: 34rpx;
    font-weight: 700;
}

.login-desc,
.empty-desc {
    margin-top: 12rpx;
    color: #7C8493;
    font-size: 26rpx;
    line-height: 1.6;
}

.login-note {
    margin-top: 24rpx;
    color: #A0A7B4;
    font-size: 22rpx;
    line-height: 1.6;
}

.primary-btn {
    width: 100%;
    margin: 32rpx 0 0;
    padding: 0;
    border: none;
    border-radius: 18rpx;
    background: #4C6FFF;
    color: #FFFFFF;
    font-size: 30rpx;
    font-weight: 600;
    line-height: 88rpx;
}

.primary-btn.small {
    width: 60%;
}

.ghost-btn {
    margin: 0;
    padding: 0;
    border: 2rpx solid #E4E8F0;
    border-radius: 18rpx;
    background: #FFFFFF;
    color: #4A5261;
    font-size: 30rpx;
    line-height: 84rpx;
}

.section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 8rpx 4rpx 20rpx;
}

.section-title,
.card-title {
    color: #1F2329;
    font-size: 32rpx;
    font-weight: 700;
}

.section-link {
    color: #4C6FFF;
    font-size: 28rpx;
    font-weight: 600;
}

.section-count {
    margin-left: 12rpx;
    color: #A0A7B4;
    font-size: 24rpx;
    font-weight: 400;
}

.task-strip {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 12rpx;
}

.task-tip {
    display: block;
    margin: 0 4rpx 24rpx;
    color: #A0A7B4;
    font-size: 22rpx;
}

.task-chip-hover {
    background: #EEF2FF;
}

.task-chip {
    display: flex;
    align-items: center;
    margin: 0 16rpx 16rpx 0;
    padding: 14rpx 22rpx;
    border: 2rpx solid #E9ECF2;
    border-radius: 999rpx;
    background: #FFFFFF;
}

.task-chip.active {
    background: #F4F7FF;
}

.task-chip.add {
    border-style: dashed;
}

.task-chip-icon {
    font-size: 28rpx;
}

.task-chip-name {
    margin-left: 10rpx;
    color: #3B4351;
    font-size: 26rpx;
}

.checkin-card {
    box-sizing: border-box;
    margin-bottom: 24rpx;
    padding: 32rpx;
    border-radius: 28rpx;
    color: #FFFFFF;
}

.checkin-top {
    display: flex;
    align-items: center;
}

.checkin-icon {
    font-size: 52rpx;
}

.checkin-meta {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin-left: 20rpx;
}

.checkin-name {
    font-size: 34rpx;
    font-weight: 700;
}

.checkin-sub {
    margin-top: 6rpx;
    color: rgba(255, 255, 255, 0.85);
    font-size: 24rpx;
}

/* 编辑入口在卡片顶部，与底部签到按钮拉开距离，不做破坏性操作 */
.edit-task-btn {
    padding: 8rpx 22rpx;
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.22);
    color: #FFFFFF;
    font-size: 24rpx;
}

.checkin-btn {
    margin: 32rpx 0 0;
    padding: 0;
    border: none;
    border-radius: 18rpx;
    background: #FFFFFF;
    color: #2B3A7A;
    font-size: 32rpx;
    font-weight: 700;
    line-height: 92rpx;
}

.checkin-btn.done {
    background: rgba(255, 255, 255, 0.22);
    color: #FFFFFF;
}

.checkin-hint {
    display: block;
    margin-top: 16rpx;
    color: rgba(255, 255, 255, 0.85);
    font-size: 22rpx;
    text-align: center;
}

/* 签到积分：总积分、当前档位、等级 */
.point-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.point-head-left {
    display: flex;
    flex-direction: column;
}

.point-title {
    color: #8A93A3;
    font-size: 26rpx;
}

.point-total-row {
    display: flex;
    align-items: baseline;
    margin-top: 6rpx;
}

.point-total {
    color: #4C6FFF;
    font-size: 60rpx;
    font-weight: 700;
    line-height: 72rpx;
}

.point-unit {
    margin-left: 8rpx;
    color: #8A93A3;
    font-size: 24rpx;
}

/* 规则弹层唯一入口：只给等级徽标保留点击热区，卡片其余部分不响应。 */
.point-level {
    padding: 12rpx 24rpx;
    border-radius: 999rpx;
    background: #EEF2FF;
    color: #4C6FFF;
    font-size: 24rpx;
    font-weight: 600;
}

.point-meta {
    margin-top: 16rpx;
    padding-top: 16rpx;
    border-top: 2rpx solid #F2F4F8;
    color: #8A93A3;
    font-size: 24rpx;
    line-height: 36rpx;
}

.point-brief {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 20rpx;
    padding: 20rpx 24rpx;
    border-radius: 18rpx;
    background: #F6F8FF;
}

.point-brief-label {
    color: #8A93A3;
    font-size: 26rpx;
}

.point-brief-num {
    margin-left: 16rpx;
    color: #4C6FFF;
    font-size: 40rpx;
    font-weight: 700;
}

/* 「我的」页的同款入口：只放大等级文字的热区，不改变视觉位置。 */
.point-brief-level {
    padding: 12rpx 0 12rpx 24rpx;
    color: #4C6FFF;
    font-size: 24rpx;
}

.stats-row {
    display: flex;
    align-items: center;
    margin-bottom: 24rpx;
    padding: 28rpx 16rpx;
    border-radius: 24rpx;
    background: #FFFFFF;
    box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.04);
}

.stats-row.inner {
    margin: 24rpx 0 0;
    padding: 20rpx 0;
    box-shadow: none;
}

.stat-item {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
}

.stat-num {
    color: #4C6FFF;
    font-size: 42rpx;
    font-weight: 700;
}

.stat-label {
    margin-top: 6rpx;
    color: #8A93A3;
    font-size: 22rpx;
}

.stat-divider {
    width: 2rpx;
    height: 48rpx;
    background: #EDF0F5;
}

/* 空状态卡与常规卡片共用白底，也需要同样的下间距；否则无任务时它会和积分卡贴在一起 */
.card,
.empty-card {
    margin-bottom: 24rpx;
}

.calendar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24rpx;
}

.calendar-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: -8rpx 0 20rpx;
    color: #8A93A3;
    font-size: 24rpx;
}

/* 翻到其它月份时才出现的快捷回退入口 */
.back-today {
    padding: 8rpx 18rpx;
    border-radius: 999rpx;
    background: #EEF2FF;
    color: #4C6FFF;
    font-size: 24rpx;
    font-weight: 600;
}

/* 长按撤销当天签到的倒计时与进度 */
.hold-bar {
    margin: 0 0 20rpx;
    padding: 18rpx 20rpx;
    border-radius: 16rpx;
    background: #FFF4EA;
}

.hold-bar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #B26A17;
    font-size: 24rpx;
}

.hold-bar-cancel {
    color: #B99A78;
    font-size: 22rpx;
}

.hold-track {
    height: 10rpx;
    margin-top: 14rpx;
    overflow: hidden;
    border-radius: 999rpx;
    background: #F4DFC8;
}

.hold-fill {
    height: 100%;
    border-radius: 999rpx;
    background: linear-gradient(90deg, #FFB020, #F0802A);
}

.cal-title {
    font-size: 30rpx;
    font-weight: 700;
}

.cal-nav {
    display: flex;
    width: 60rpx;
    height: 60rpx;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #F3F5F9;
    color: #4A5261;
    font-size: 40rpx;
}

.week-row {
    display: flex;
    margin-bottom: 12rpx;
}

.week-cell {
    width: 14.2857%;
    color: #9AA2B1;
    font-size: 22rpx;
    text-align: center;
}

.cal-grid {
    display: flex;
    flex-wrap: wrap;
}

.cal-cell {
    position: relative;
    display: flex;
    width: calc(14.2857% - 8rpx);
    height: 80rpx;
    margin: 4rpx;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    border-radius: 16rpx;
}

.cal-cell.blank {
    background: transparent;
}

.cal-cell.is-signed {
    background: linear-gradient(135deg, #4C6FFF, #6E8BFF);
    box-shadow: 0 6rpx 14rpx rgba(76, 111, 255, 0.28);
}

.cal-cell.is-plain {
    background: #E9ECF2;
}

.cal-cell.is-future {
    background: #F4F6F9;
}

.cal-cell.is-today {
    box-shadow: 0 0 0 3rpx #FFB020;
}

/* 正在长按倒计时的格子，用橙色描边明确反馈 */
.cal-cell.is-holding {
    box-shadow: 0 0 0 4rpx #F0802A;
}

.cal-day {
    font-size: 26rpx;
    font-weight: 600;
}

.is-signed .cal-day {
    color: #FFFFFF;
}

.is-plain .cal-day {
    color: #8C94A3;
}

.is-future .cal-day {
    color: #C2C8D2;
}

.cal-check {
    position: absolute;
    right: 10rpx;
    bottom: 6rpx;
    color: #FFFFFF;
    font-size: 18rpx;
}

.legend {
    display: flex;
    justify-content: center;
    margin-top: 24rpx;
}

.legend-item {
    display: flex;
    align-items: center;
    margin-right: 28rpx;
    color: #8A93A3;
    font-size: 22rpx;
}

.legend-dot {
    width: 20rpx;
    height: 20rpx;
    margin-right: 8rpx;
    border-radius: 6rpx;
}

.legend-dot.signed {
    background: #4C6FFF;
}

.legend-dot.plain {
    background: #E9ECF2;
}

.legend-dot.today {
    border: 3rpx solid #FFB020;
    background: transparent;
}

.cal-cancel-tip {
    display: block;
    margin-top: 18rpx;
    color: #A0A7B4;
    font-size: 22rpx;
    text-align: center;
}

.record-empty {
    margin-top: 24rpx;
    color: #A0A7B4;
    font-size: 26rpx;
    text-align: center;
}

.record-row {
    display: flex;
    align-items: center;
    margin-top: 20rpx;
    padding: 18rpx 0;
    border-top: 2rpx solid #F2F4F8;
}

.record-dot {
    width: 16rpx;
    height: 16rpx;
    margin-right: 16rpx;
    border-radius: 50%;
    background: #4C6FFF;
}

.record-date {
    flex: 1;
    color: #3B4351;
    font-size: 26rpx;
}

.record-time {
    margin-right: 20rpx;
    color: #9AA2B1;
    font-size: 24rpx;
}

.record-tag {
    padding: 6rpx 14rpx;
    border-radius: 999rpx;
    background: #EEF2FF;
    color: #4C6FFF;
    font-size: 22rpx;
}

.record-tag.earned {
    background: #FFF3DC;
    color: #B7791F;
}

.profile-head {
    display: flex;
    align-items: center;
    margin-bottom: 28rpx;
}

.avatar {
    display: flex;
    width: 108rpx;
    height: 108rpx;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 52rpx;
}

.profile-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin-left: 24rpx;
}

.profile-name {
    font-size: 36rpx;
    font-weight: 700;
}

.profile-sub {
    margin-top: 8rpx;
    color: #9AA2B1;
    font-size: 24rpx;
}

.edit-link {
    padding: 10rpx 24rpx;
    border-radius: 999rpx;
    background: #F3F5F9;
    color: #4C6FFF;
    font-size: 24rpx;
}

.info-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 0;
    border-top: 2rpx solid #F2F4F8;
}

.info-label {
    color: #8A93A3;
    font-size: 26rpx;
}

.info-value {
    max-width: 60%;
    color: #3B4351;
    font-size: 24rpx;
    text-align: right;
}

.avatar-grid {
    display: flex;
    flex-wrap: wrap;
    margin-top: 24rpx;
}

.avatar-option {
    display: flex;
    width: 96rpx;
    height: 96rpx;
    margin: 0 20rpx 20rpx 0;
    align-items: center;
    justify-content: center;
    border: 4rpx solid transparent;
    border-radius: 50%;
    font-size: 44rpx;
}

.avatar-option.active {
    border-color: #4C6FFF;
}

.mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 30;
    display: flex;
    align-items: flex-end;
    background: rgba(24, 30, 42, 0.45);
}

.sheet {
    box-sizing: border-box;
    width: 100%;
    padding: 40rpx 32rpx 56rpx;
    border-radius: 32rpx 32rpx 0 0;
    background: #FFFFFF;
}

.sheet-title {
    display: block;
    margin-bottom: 28rpx;
    font-size: 34rpx;
    font-weight: 700;
}

.sheet-label {
    display: block;
    margin: 24rpx 0 12rpx;
    color: #8A93A3;
    font-size: 24rpx;
}

.field {
    box-sizing: border-box;
    width: 100%;
    height: 88rpx;
    padding: 0 24rpx;
    border-radius: 16rpx;
    background: #F4F6FA;
    color: #1F2329;
    font-size: 28rpx;
}

/* 输入框下方的实时字数计数，靠右对齐 */
.field-meta {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: 10rpx;
    padding: 0 4rpx;
}

.field-count {
    color: #8A93A3;
    font-size: 22rpx;
    font-variant-numeric: tabular-nums;
}

/* 到达上限时给个温和的提醒色 */
.field-count.limit {
    color: #E8703A;
    font-weight: 600;
}

/* 设置弹层里的实时预览，随草稿头像/昵称变化 */
.settings-preview {
    display: flex;
    align-items: center;
    padding: 24rpx 28rpx;
    border-radius: 20rpx;
}

.settings-preview-emoji {
    font-size: 64rpx;
}

.settings-preview-name {
    margin-left: 24rpx;
    color: #1F2329;
    font-size: 32rpx;
    font-weight: 600;
}

.icon-grid,
.color-grid {
    display: flex;
    flex-wrap: wrap;
}

.icon-option {
    display: flex;
    width: 80rpx;
    height: 80rpx;
    margin: 0 16rpx 16rpx 0;
    align-items: center;
    justify-content: center;
    border: 3rpx solid transparent;
    border-radius: 20rpx;
    background: #F4F6FA;
    font-size: 36rpx;
}

.icon-option.active {
    border-color: #4C6FFF;
    background: #EEF2FF;
}

.color-option {
    width: 64rpx;
    height: 64rpx;
    margin: 0 20rpx 16rpx 0;
    border: 4rpx solid #FFFFFF;
    border-radius: 50%;
    box-shadow: 0 0 0 2rpx #E9ECF2;
}

.color-option.active {
    box-shadow: 0 0 0 4rpx #4C6FFF;
}

/* 积分与等级详情弹层 */
.points-sheet {
    /* 等级扩到 10 档后内容更长，弹层给足高度，其余靠滚动 */
    height: 84vh;
    padding-bottom: 40rpx;
    /* 滚到边界不要把滚动链传给下层容器 */
    overscroll-behavior: contain;
}

/* 组件样式隔离下再兜一层：隐藏 scroll-view 的滚动条，不影响滑动 */
scroll-view::-webkit-scrollbar,
.points-sheet::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
    background: transparent;
}

.points-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx 28rpx;
    border-radius: 20rpx;
    background: #F6F8FF;
}

.points-summary-label {
    display: block;
    color: #8A93A3;
    font-size: 24rpx;
}

.points-summary-value {
    display: block;
    margin-top: 6rpx;
    color: #4C6FFF;
    font-size: 64rpx;
    font-weight: 700;
    line-height: 76rpx;
}

.points-summary-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

.points-summary-level {
    padding: 8rpx 20rpx;
    border-radius: 999rpx;
    background: #FFFFFF;
    color: #4C6FFF;
    font-size: 26rpx;
    font-weight: 600;
}

.points-summary-sub {
    margin-top: 12rpx;
    color: #8A93A3;
    font-size: 22rpx;
}

.level-row {
    display: flex;
    align-items: center;
    padding: 18rpx 4rpx;
    border-bottom: 2rpx solid #F2F4F8;
}

.level-row.current {
    background: #F8FAFF;
}

.level-dot {
    width: 14rpx;
    height: 14rpx;
    margin-right: 16rpx;
    border-radius: 50%;
    background: #D9DEE8;
}

.level-dot.reached {
    background: #4C6FFF;
}

/* 每级一个 Lv 徽章，等级名与徽章同色，由 JS 按词库下发，样式只管排版 */
.level-badge {
    margin-right: 14rpx;
    padding: 4rpx 10rpx;
    border-radius: 8rpx;
    font-size: 20rpx;
    font-weight: 600;
    line-height: 28rpx;
}

.level-name {
    width: 150rpx;
    color: #3B4351;
    font-size: 28rpx;
}

.level-name.current {
    font-weight: 700;
}

.level-range {
    flex: 1;
    color: #8A93A3;
    font-size: 24rpx;
}

.level-state {
    color: #8A93A3;
    font-size: 24rpx;
}

.level-state.current {
    color: #4C6FFF;
    font-weight: 600;
}

.level-state.pending {
    color: #B7791F;
}

.rule-note {
    display: flex;
    flex-direction: column;
    color: #8A93A3;
    font-size: 24rpx;
    line-height: 38rpx;
}

.stage-row {
    display: flex;
    align-items: center;
    padding: 16rpx 4rpx;
    border-bottom: 2rpx solid #F2F4F8;
}

.stage-days {
    flex: 1;
    color: #3B4351;
    font-size: 26rpx;
}

.stage-gain {
    color: #4C6FFF;
    font-size: 28rpx;
    font-weight: 600;
}

.stage-cap {
    margin-left: 12rpx;
    padding: 4rpx 12rpx;
    border-radius: 999rpx;
    background: #FFF3DC;
    color: #B7791F;
    font-size: 20rpx;
}

.sheet-actions {
    display: flex;
    margin-top: 32rpx;
}

.sheet-actions .ghost-btn,
.sheet-actions .primary-btn {
    flex: 1;
    margin: 0;
}

.sheet-actions .ghost-btn {
    margin-right: 20rpx;
}

/* 任务拖动排序：按住手柄拖动，列表本身只在未拖动时允许滚动。 */
.sort-sheet {
    padding-bottom: 40rpx;
}

.sort-list {
    max-height: 60vh;
    margin-top: 8rpx;
}

.sort-row {
    position: relative;
    display: flex;
    align-items: center;
    height: 84rpx;
    margin-bottom: 10rpx;
    padding: 0 12rpx 0 20rpx;
    border: 2rpx solid #E9ECF2;
    border-left: 8rpx solid #4C6FFF;
    border-radius: 18rpx;
    background: #FFFFFF;
    transition: transform 0.18s ease;
}

.sort-row.dragging {
    z-index: 2;
    border-color: #4C6FFF;
    background: #F4F7FF;
    box-shadow: 0 12rpx 28rpx rgba(76, 111, 255, 0.22);
    transition: none;
}

/* 松手瞬间：先无过渡地重排并抵消跳变，下一帧再开启过渡平滑归位，避免弹跳。 */
.sort-sheet.committing .sort-row {
    transition: none;
}

.sort-icon {
    font-size: 30rpx;
}

.sort-name {
    flex: 1;
    margin-left: 16rpx;
    color: #3B4351;
    font-size: 28rpx;
}

.sort-order {
    margin-right: 20rpx;
    color: #A0A7B4;
    font-size: 24rpx;
}

.sort-handle {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 72rpx;
    height: 64rpx;
    border-radius: 14rpx;
    background: #F4F6FA;
}

.sort-handle-bar {
    width: 28rpx;
    height: 3rpx;
    margin: 3rpx 0;
    border-radius: 2rpx;
    background: #98A2B3;
}

.tabbar {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 10;
    display: flex;
    height: 112rpx;
    border-top: 2rpx solid #EDF0F5;
    background: #FFFFFF;
}

.tab-item {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.tab-icon {
    color: #A7AEBB;
    font-size: 36rpx;
    line-height: 1.1;
}

/* 「我的」tab：纯 CSS 人形图标，未选中灰、选中蓝，与「签到」勾选图标风格一致 */
.profile-icon {
    position: relative;
    width: 36rpx;
    height: 36rpx;
}

.profile-icon-head,
.profile-icon-body {
    position: absolute;
    background: #A7AEBB;
}

.profile-icon-head {
    top: 3rpx;
    left: 11rpx;
    width: 14rpx;
    height: 14rpx;
    border-radius: 50%;
}

.profile-icon-body {
    bottom: 3rpx;
    left: 5rpx;
    width: 26rpx;
    height: 14rpx;
    border-radius: 14rpx 14rpx 0 0;
}

.tab-item.active .profile-icon-head,
.tab-item.active .profile-icon-body {
    background: #4C6FFF;
}

.tab-text {
    margin-top: 6rpx;
    color: #A7AEBB;
    font-size: 22rpx;
}

.tab-item.active .tab-icon,
.tab-item.active .tab-text {
    color: #4C6FFF;
    font-weight: 600;
}

/* 首屏骨架屏：结构与真实页面一致，接口返回后原位替换，不会再出现整片空白。 */
.skeleton {
    box-sizing: border-box;
}

.sk {
    background: #EDF0F5;
    border-radius: 12rpx;
    animation: sk-pulse 1.3s ease-in-out infinite;
}

@keyframes sk-pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
}

.sk-heading {
    width: 260rpx;
    height: 34rpx;
    margin: 4rpx 0 28rpx;
    border-radius: 10rpx;
}

.sk-strip {
    display: flex;
    margin-bottom: 24rpx;
}

.sk-chip {
    width: 150rpx;
    height: 62rpx;
    margin-right: 16rpx;
    border-radius: 999rpx;
}

.sk-chip.short {
    width: 110rpx;
}

.sk-checkin {
    box-sizing: border-box;
    margin-bottom: 24rpx;
    padding: 32rpx;
    border-radius: 28rpx;
    background: #E4E9F4;
}

.sk-checkin-top {
    display: flex;
    align-items: center;
}

.sk-avatar {
    width: 76rpx;
    height: 76rpx;
    margin-right: 20rpx;
    border-radius: 24rpx;
    background: #DCE3F0;
}

.sk-checkin-lines {
    flex: 1;
}

.sk-line {
    height: 22rpx;
    margin-bottom: 16rpx;
}

.sk-line.w30 { width: 30%; }
.sk-line.w40 { width: 40%; }
.sk-line.w50 { width: 50%; }
.sk-line.w60 { width: 60%; }
.sk-line.w70 { width: 70%; }
.sk-line.w80 { width: 80%; }

.sk-action {
    height: 78rpx;
    margin-top: 24rpx;
    border-radius: 18rpx;
    background: #DCE3F0;
}

/* 积分卡骨架：与日历/记录骨架保持「白卡片 + 灰线条」的同一观感 */
.sk-point-card {
    margin-bottom: 24rpx;
}

.sk-point-box {
    height: 72rpx;
    margin: 8rpx 0 20rpx;
    border-radius: 18rpx;
}

.sk-week {
    display: flex;
    flex-wrap: wrap;
    margin: 24rpx 0 8rpx;
}

.sk-calendar .sk-day {
    box-sizing: border-box;
    width: calc(14.2857% - 8rpx);
    height: 80rpx;
    margin: 4rpx;
    border-radius: 16rpx;
}

.sk-legend {
    display: flex;
    margin-top: 16rpx;
}

.sk-legend .sk-line {
    margin-right: 20rpx;
}

.sk-records .sk-line {
    margin-top: 20rpx;
}
